# No crystal on the board: DPLL0 (CPU, 120 MHz) is referenced from the internal
# OSCULP32K; USB and CAN run from the 48 MHz DFLL.
CONFIG_SOC_ATMEL_SAMD5X_OSCULP32K_AS_MAIN=y

# 16 KiB Adafruit-style UF2 bootloader at 0x0000, application at 0x4000.
CONFIG_BOOTLOADER_BOSSA=y
CONFIG_BOOTLOADER_BOSSA_ADAFRUIT_UF2=y
CONFIG_BUILD_OUTPUT_HEX=y
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_BUILD_OUTPUT_UF2_FAMILY_ID="0x55114460"

CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_GPIO=y
CONFIG_PINCTRL=y

# Console on the USB CDC ACM port.
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_UART_LINE_CTRL=y
CONFIG_USB_DEVICE_STACK=y
CONFIG_USB_DEVICE_INITIALIZE_AT_BOOT=y
CONFIG_USB_CDC_ACM=y
CONFIG_USB_DEVICE_MANUFACTURER="Longan Labs"
CONFIG_USB_DEVICE_PRODUCT="CANBed M4 (Zephyr)"
CONFIG_USB_DEVICE_VID=0x03EB
CONFIG_USB_DEVICE_PID=0x802B

# 1200-baud touch on the CDC port reboots into the UF2 bootloader.
CONFIG_CDC_ACM_DTE_RATE_CALLBACK_SUPPORT=y
CONFIG_BOOTLOADER_BOSSA_DEVICE_NAME="cdc_acm_uart0"
