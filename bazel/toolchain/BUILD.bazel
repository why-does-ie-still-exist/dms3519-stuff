load("@arm_none_eabi//toolchain:toolchain.bzl", "arm_none_eabi_toolchain")

# Cortex-M4F toolchain.  All other flags (warnings, C++ dialect, linker
# options) come from modm via //modm:flags.bzl so they stay in sync with
# project.xml.
MCU_FLAGS = [
    "-mcpu=cortex-m4",
    "-mthumb",
    "-mfloat-abi=hard",
    "-mfpu=fpv4-sp-d16",
]

arm_none_eabi_toolchain(
    name = "cortex_m4f",
    copts = MCU_FLAGS,
    linkopts = MCU_FLAGS,
    target_compatible_with = [
        "@platforms//os:none",
        "@platforms//cpu:armv7e-mf",
    ],
)
